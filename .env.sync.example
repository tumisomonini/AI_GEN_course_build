# Neo4j Sync Environment Variables
#
# Copy this file to .env.sync and fill in your credentials.
# Usage:
#   python Application/Scripts/sync_neo4j.py --source local --target cloud --env-file .env.sync
#
# ---------------------------------------------------------------------------
# SOURCE = Local Docker Neo4j (default)
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# TARGET = Neo4j Aura (cloud)
# ---------------------------------------------------------------------------
# Uncomment and set these to sync to Aura.
# The prefix TARGET_ isolates cloud credentials from local ones.
# ---------------------------------------------------------------------------
# TARGET_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io:7687
# TARGET_NEO4J_USERNAME=neo4j
# TARGET_NEO4J_PASSWORD=<your-aura-password>
# TARGET_NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# REVERSE SYNC (Cloud → Local)
# ---------------------------------------------------------------------------
# If you want to pull from Aura back to Docker, swap prefixes:
#   --source-prefix TARGET_ --target-prefix ""
# ---------------------------------------------------------------------------

