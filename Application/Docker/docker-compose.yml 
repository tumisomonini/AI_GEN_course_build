version: "3.8"

services:
  neo4j:
    image: neo4j:4.4
    ports:
      - "7474:7474"
      - "7687:7687"
    environment:
      NEO4J_AUTH: neo4j/password
    volumes:
      - neo4j_data:/data

  postgres:
    image: postgres:13
    ports:
      - "5432:5432"
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: course_db
    volumes:
      - postgres_data:/var/lib/postgresql/data

  app:
    build: .
    ports:
      - "8000:8000"
    depends_on:
      - neo4j
      - postgres
    environment:
      NEO4J_URI: bolt://neo4j:7687
      POSTGRES_URI: postgresql://postgres:postgres@postgres:5432/course_db

volumes:
  neo4j_data:
  postgres_data: