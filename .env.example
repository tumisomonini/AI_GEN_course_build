# Database Configuration
# Postgres (Docker: host 5433 -> container 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DBNAME=ai_gen_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123

# AstraDB (get from https://astra.datastax.com)
ASTRA_DB_ID=your_astra_db_id
ASTRA_DB_APPLICATION_TOKEN=your_astra_db_application_token

# Neo4j (local Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# LLM APIs
OPENROUTER_API_KEY=sk-or-v1-...  # https://openrouter.ai
# MISTRAL_API_KEY=...  # Alternative
HF_TOKEN=hf_...  # HuggingFace

# Redis (Docker)
REDIS_URL=redis://localhost:6379
