# AstraDB (Vector Database) - Get from https://astra.datastax.com
# 1. Sign up/log in (free tier available)
# 2. Create Database -> Vector Database
# 3. Create Application Token with Database Admin role
# 4. Copy ID and TOKEN, add to .env (copy .env.example -> .env)

ASTRA_DB_APPLICATION_TOKEN=your_token_here
ASTRA_DB_ID=your_database_id_here

# OpenRouter (LLM API) - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Neo4j Graph Database
NEO4J_URI=neo4j+s://your_instance.databases.neo4j.io
NEO4J_USERNAME=your_username
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=your_database
