# Environment Variables for AI Course Builder

# Postgres (docker default)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DBNAME=ai_gen_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123

# Neo4j (docker default)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Redis
REDIS_URL=redis://localhost:6379

# AstraDB (Vector DB - get from https://astra.datastax.com)
ASTRA_DB_TOKEN=your_astra_token
ASTRA_DB_ID=your_astra_db_id
ASTRA_COLLECTION_NAME=course_embeddings

# OpenAI / LLMs
OPENAI_API_KEY=your_openai_key
# Or OpenRouter: OPENROUTER_API_KEY=...

# LangSmith (optional tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=course-builder

# App
DEBUG=true

