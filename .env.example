# Database Connections
# Copy to .env and update values

## Postgres (Docker/Local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DBNAME=ai_gen_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123

## Neo4j
# Local Docker (default)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Cloud Aura Example (replace with your instance)
# NEO4J_URI=neo4j+s://abc123.databases.neo4j.io:7687
# NEO4J_PASSWORD=your_aura_password

## AstraDB (Optional RAG)
ASTRA_API_TOKEN=your_astra_token
ASTRA_COLLECTION=ai_gen_vectors

## OpenRouter API (Agents)
OPENROUTER_API_KEY=your_openrouter_key
