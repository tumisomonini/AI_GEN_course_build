# .env.example - Copy to .env and fill values
# DBs (Docker local defaults work)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DBNAME=ai_gen_db

NEO4J_URI=bolt://localhost:7687  # Local Docker (cloud skipped)
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Optional Astra (sign up free at astra.datastax.com)
ASTRA_DB_APPLICATION_TOKEN=your_astra_token_here
ASTRA_DB_ID=your_astra_db_id_here

# LLM (get free OpenRouter key at openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional
MISTRAL_API_KEY=...
LOCAL_LLM_URL=http://localhost:11434/v1  # Ollama
LLM_MODEL=openai/gpt-4o-mini
