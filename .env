# AI_GEN_course_build .env configuration template
# Fill in your actual values. Do not commit this file to git (add to .gitignore).

# Neo4j Graph Database
NEO4J_URI=neo4j+ssc://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=<your-neo4j-username>
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=<your-neo4j-database>
AURA_INSTANCEID=<your-aura-instance-id>
AURA_INSTANCENAME=<your-aura-instance-name>

# OpenAI / OpenRouter API
OPENROUTER_API_KEY=<your-openrouter-api-key>

# Astra DB Vector Store
ASTRA_TOKEN=<your-astra-token>
ASTRA_API_ENDPOINT=<your-astra-api-endpoint>
ASTRA_COLLECTION_NAME=syllabus_chunks

# Postgres Relational DB
POSTGRES_URL=postgresql://<username>:<password>@localhost:5432/course_db

# Optional: Scrapers
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; AI_GEN_scraper)

# Optional: FastAPI
DEBUG=True
